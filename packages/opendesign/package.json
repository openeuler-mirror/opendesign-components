{
  "name": "@opensig/opendesign",
  "version": "1.2.5",
  "license": "MIT",
  "main": "lib/index.js",
  "module": "es/index.mjs",
  "types": "es/index.d.ts",
  "typings": "lib/index.d.ts",
  "unpkg": "dist/opendesign.min.js",
  "files": [
    "es",
    "lib",
    "dist"
  ],
  "keywords": [
    "opendesign",
    "vue3 components"
  ],
  "scripts": {
    "gen:icon": "open-scripts gen:icon --config ./icons/icon.config.ts",
    "clean:svg": "open-scripts clean:svg --config ./icons/cleansvg.config.ts",
    "build:component": "open-scripts build:component",
    "build:style": "open-scripts build:style",
    "build": "pnpm gen:icon && pnpm build:component && pnpm build:style",
    "lint": "eslint ./src",
    "lint:fix": "eslint --fix ./src",
    "type-check": "vue-tsc --build",
    "test": "vitest --config vitest.config.ts",
    "test:run": "vitest run --config vitest.config.ts",
    "test:ui": "vitest --ui --config vitest.config.ts",
    "test:cov": "vitest run --coverage --config vitest.config.ts",
    "release": "pnpm publish --registry https://registry.npmjs.org"
  },
  "peerDependencies": {
    "@vueuse/core": "catalog:vue",
    "dayjs": "catalog:utils",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@opensig/open-scripts": "workspace:^",
    "@opensig/opendesign-token": "catalog:css",
    "@vitejs/plugin-vue": "catalog:vue",
    "@vitejs/plugin-vue-jsx": "catalog:vue",
    "@vitest/browser-playwright": "catalog:test",
    "@vitest/coverage-v8": "catalog:test",
    "@vitest/ui": "catalog:test",
    "@vue/server-renderer": "catalog:vue",
    "dayjs": "catalog:utils",
    "typescript": "catalog:typescript",
    "vite": "catalog:build",
    "vitest": "catalog:test",
    "vitest-browser-vue": "catalog:test",
    "vue-tsc": "catalog:build"
  },
  "bugs": "https://atomgit.com/openeuler/opendesign-components/issues",
  "homepage": "",
  "repository": {
    "type": "git",
    "url": "https://atomgit.com/openeuler/opendesign-components.git"
  }
}
