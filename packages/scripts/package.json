    "jiti": "catalog:io",
    "sass-embedded": "catalog:css",
    "svgo": "catalog:build",
    "vite": "catalog:build",
    "vite-plugin-dts": "catalog:build"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "catalog:build",
    "@types/clean-css": "catalog:typescript",
    "@types/glob": "catalog:typescript",
    "@types/node": "catalog:typescript",
    "@vitejs/plugin-vue": "catalog:vue",
    "clean-css": "catalog:css",
    "commander": "catalog:io",
    "glob": "catalog:io",
    "globals": "catalog:lint",
    "jiti": "catalog:io",
    "sass-embedded": "catalog:css",
    "svgo": "catalog:build",
    "vite": "catalog:build",
    "vite-plugin-dts": "catalog:build"
