{
  "name": "@opensig/open-scripts",
  "version": "1.0.5",
  "description": "opendesign component Scripts",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "bin": {
