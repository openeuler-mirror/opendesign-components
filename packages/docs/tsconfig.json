{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@opensig/opendesign/*": ["../opendesign/src/*"],
      "@opensig/opendesign": ["../opendesign/src/index.ts"]
    }
  },
  "include": ["shared/**/*.ts", "src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue", "../opendesign/**/*.ts","__tests__/**/*.ts", "vitest.config.ts", "vitest.ssr.config.ts"],
  "exclude": ["../opendesign/**/*.config.ts"],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
