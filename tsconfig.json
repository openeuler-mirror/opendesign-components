{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["eslint.*", "prettier.*", "packages/skills/**/*", "eslint-rules/**/*"]
}
